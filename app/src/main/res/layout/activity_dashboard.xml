<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    tools:context=".activity_dashboard">

    <!-- כותרת ראשית -->
    <TextView
        android:id="@+id/tvWelcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="החשבון שלי - פיננסים"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- כרטיסייה לחיסכון בחודש שעבר -->
    <TextView
        android:id="@+id/tvLastMonthSavings"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="כמה חסכת בחודש שעבר: ₪0"
        android:textSize="18sp"
        android:background="#E0F7FA"
        android:padding="16dp"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/tvWelcome"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- סיכום הכנסות -->
    <TextView
        android:id="@+id/tvIncome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="הכנסות החודש: ₪0"
        android:textSize="16sp"
        android:background="#E8F5E9"
        android:padding="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvLastMonthSavings"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- סיכום הוצאות -->
    <TextView
        android:id="@+id/tvExpenses"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="הוצאות החודש: ₪0"
        android:textSize="16sp"
        android:background="#FFEBEE"
        android:padding="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvIncome"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>